{
  "name": "dsh-wechat-daily",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness plugin: a Settings-resident WeChat daily report. Reads local WeChat 4.x databases read-only (SQLCipher), ranks each day's chats, and separates what needs you from what to ignore. Local-first; the model step is optional.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs",
    "tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "Zeng pu",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "weixin",
    "daily-report",
    "sqlcipher",
    "wcdb",
    "macos",
    "local-first",
    "privacy"
  ],
  "engines": {
    "node": ">=23.4.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  }
}